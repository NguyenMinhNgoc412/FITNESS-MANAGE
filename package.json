{
  "name": "fitness-manage",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @fitness/api start:dev",
    "dev:ai": "node scripts/ai.mjs dev",
    "dev:app": "pnpm --filter @fitness/app start",
    "build": "pnpm --filter @fitness/api build && pnpm --filter @fitness/app typecheck",
    "test": "pnpm test:api && pnpm test:app && pnpm test:ai",
    "test:api": "pnpm --filter @fitness/api test",
    "test:app": "pnpm --filter @fitness/app test",
    "test:ai": "node scripts/ai.mjs test",
    "check": "pnpm lint && pnpm build && pnpm test",
    "lint": "pnpm --filter @fitness/api lint && pnpm --filter @fitness/app lint",
    "prepare:pose": "node scripts/prepare-pose.mjs"
  }
}

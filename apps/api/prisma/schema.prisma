generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  PT
  MEMBER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum PackageMode {
  TIME_BASED
  SESSION_BASED
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  phone        String        @unique
  passwordHash String
  role         Role
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  sessions     Session[]
  @@map("users")
}

model Profile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  fullName  String
  cccd      String?
  dob       DateTime?
  gender    String?
  address   String?
  avatarUrl String?
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("profiles")
}

model Session {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  user             User     @relation(fields: [userId], references: [id])
  createdAt        DateTime @default(now())
  @@index([userId])
  @@map("sessions")
}

model Customer {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  phone        String   @unique
  fullName     String
  trialUsedEver Boolean @default(true)
  memberUserId String?  @db.ObjectId
  status       String   @default("TRIAL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("customers")
}

model TrialEntitlement {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String @unique @db.ObjectId
  totalSessions Int    @default(3)
  usedSessions  Int    @default(0)
  status        String @default("ACTIVE")
  createdAt     DateTime @default(now())
  @@map("trial_entitlements")
}

model Membership {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  memberId      String      @db.ObjectId
  mode          PackageMode
  name          String
  startAt       DateTime
  endAt         DateTime?
  totalSessions Int?
  priceVnd      Int?
  usedSessions  Int         @default(0)
  status        String      @default("ACTIVE")
  createdBy     String      @db.ObjectId
  renewedFromId String?     @db.ObjectId
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([memberId, startAt])
  @@map("memberships")
}

model PtAssignment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String    @db.ObjectId
  ptId      String    @db.ObjectId
  startAt   DateTime  @default(now())
  endAt     DateTime?
  status    String    @default("ACTIVE")
  reason    String
  changedBy String    @db.ObjectId
  @@index([ptId, status])
  @@index([memberId, startAt])
  @@map("pt_assignments")
}

model Booking {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  memberId     String    @db.ObjectId
  ptId         String    @db.ObjectId
  startAt      DateTime
  endAt        DateTime
  status       String    @default("SCHEDULED")
  notes        String?
  createdBy    String    @db.ObjectId
  cancelReason String?
  cancelledBy  String?   @db.ObjectId
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([ptId, startAt, endAt])
  @@index([memberId, startAt, endAt])
  @@map("bookings")
}

model MemberCheckin {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  subjectType      String
  customerId       String?  @db.ObjectId
  memberId         String?  @db.ObjectId
  context          String
  bookingId        String?  @db.ObjectId
  membershipId     String?  @db.ObjectId
  externalPtPassId String?  @db.ObjectId
  checkedInAt      DateTime @default(now())
  method           String
  operatorId       String   @db.ObjectId
  idempotencyKey   String   @unique
  @@index([memberId, checkedInAt])
  @@index([customerId, checkedInAt])
  @@index([checkedInAt])
  @@map("member_checkins")
}

model PtAttendanceLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  ptId           String   @db.ObjectId
  checkedInAt    DateTime @default(now())
  source         String   @default("APP")
  idempotencyKey String   @unique
  @@index([ptId, checkedInAt])
  @@map("pt_attendance_logs")
}

model ExternalPtPass {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String   @db.ObjectId
  totalUses Int
  usedUses  Int      @default(0)
  status    String   @default("ACTIVE")
  createdBy String   @db.ObjectId
  createdAt DateTime @default(now())
  @@index([memberId, status])
  @@map("external_pt_passes")
}

model ExternalPtRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId     String   @db.ObjectId
  membershipId String   @db.ObjectId
  passId       String   @db.ObjectId
  initiatedBy  String   @db.ObjectId
  status       String   @default("PENDING")
  checkinId    String?  @db.ObjectId
  createdAt    DateTime @default(now())
  @@index([memberId, status])
  @@map("external_pt_requests")
}

model SalesAlert {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sourceKey    String   @unique
  customerId   String?  @db.ObjectId
  memberId     String?  @db.ObjectId
  type         String
  status       String   @default("OPEN")
  ownerNote    String?
  triggeredAt  DateTime @default(now())
  resolvedAt   DateTime?
  @@index([status, type])
  @@map("sales_alerts")
}

model DeviceToken {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  token     String @unique
  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  recipientId String   @db.ObjectId
  type        String
  resourceId  String
  status      String   @default("PENDING")
  errorCode   String?
  attempts    Int      @default(0)
  claimToken  String?
  leaseUntil  DateTime?
  nextAttemptAt DateTime?
  createdAt   DateTime @default(now())
  @@index([recipientId, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId      String   @db.ObjectId
  action       String
  resourceType String
  resourceId   String
  reason       String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Command {
  id          String   @id @map("_id")
  fingerprint String
  result      Json
  createdAt   DateTime @default(now())
  @@map("commands")
}

model WriteLock {
  id      String @id @map("_id")
  version Int    @default(0)
  @@map("write_locks")
}

model WorkoutSession {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  workoutDate String
  title String @default("")
  note String @default("")
  status String @default("DRAFT")
  statusBeforeArchive String?
  exercises Json
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  archivedAt DateTime?
  @@index([memberId, status, workoutDate, id])
  @@map("workout_sessions")
}

model WorkoutRevision {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String @db.ObjectId
  memberId String @db.ObjectId
  version Int
  action String
  actorId String @db.ObjectId
  snapshot Json
  recordedAt DateTime @default(now())
  @@unique([sessionId, version])
  @@index([memberId, sessionId, version])
  @@map("workout_session_revisions")
}

model BodyMeasurement {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  measurementDate String
  weightUnits Int?
  heightUnits Int?
  status String @default("ACTIVE")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  @@index([memberId, status, measurementDate, id])
  @@map("body_measurements")
}

model MeasurementRevision {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  measurementId String @db.ObjectId
  memberId String @db.ObjectId
  version Int
  action String
  actorId String @db.ObjectId
  snapshot Json
  recordedAt DateTime @default(now())
  @@unique([measurementId, version])
  @@index([memberId, measurementId, version])
  @@map("body_measurement_revisions")
}

model ExerciseCatalog {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  code String @unique
  status String @default("DRAFT")
  currentPublishedVersion Int
  nameVi String
  searchText String
  muscleGroups String[]
  equipmentCodes String[]
  @@index([status, nameVi, id])
  @@map("exercise_catalog")
}

model ExerciseCatalogVersion {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  catalogExerciseId String @db.ObjectId
  contentVersion Int
  content Json
  publishedAt DateTime @default(now())
  @@unique([catalogExerciseId, contentVersion])
  @@map("exercise_catalog_versions")
}

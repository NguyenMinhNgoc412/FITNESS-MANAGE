{
  "expo": {
    "name": "FITNESS-MANAGE",
    "slug": "fitness-manage",
    "version": "1.0.0",
    "scheme": "fitness-manage",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#126B5B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitnessmanage.app"
    },
    "android": {
      "package": "com.fitnessmanage.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#126B5B"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

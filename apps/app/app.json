{
  "expo": {
    "name": "FITNESS-MANAGE",
    "slug": "fitness-manage",
    "version": "1.0.0",
    "scheme": "fitness-manage",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitnessmanage.app"
    },
    "android": {
      "package": "com.fitnessmanage.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F9FC"
      }
    },
    "web": {
      "favicon": "./assets/icon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép FITNESS-MANAGE quét QR check-in.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn video bài tập để phân tích ngay trên thiết bị.",
          "cameraPermission": "Cho phép quay video bài tập lưu trên thiết bị.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F9FC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

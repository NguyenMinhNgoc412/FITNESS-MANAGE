{
  "expo": {
    "name": "FITNESS-MANAGE",
    "slug": "fitness-manage",
    "version": "1.0.0",
    "scheme": "fitness-manage",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F9FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitnessmanage.app"
    },
    "android": {
      "package": "com.fitnessmanage.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F9FC"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Cho phép FITNESS-MANAGE quét QR check-in.", "recordAudioAndroid": false }],
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn video bài tập để phân tích ngay trên thiết bị.",
          "cameraPermission": "Cho phép quay video bài tập lưu trên thiết bị.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
